{
  "info": {
    "name": "Que Sale - Communities",
    "description": "Pruebas de comunidades, miembros y publicaciones. Configura adminId, memberId y outsiderId con estudiantes existentes: adminId y memberId de la misma universidad, outsiderId sin unirse. Ejecutar en orden. X-Student-Id es provisional (D-16).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminId",
      "value": "1"
    },
    {
      "key": "memberId",
      "value": "2"
    },
    {
      "key": "outsiderId",
      "value": "3"
    },
    {
      "key": "communityId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "POST crear comunidad → 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{adminId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/communities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "communities"
          ]
        },
        "description": "Crea la comunidad en la universidad del estudiante; el creador entra como ADMIN. Guarda communityId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ajedrez\",\n  \"description\": \"Torneos semanales\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST crear comunidad → 201 responde 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('communityId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
