{
  "info": {
    "_postman_id": "b3be7d71-cadd-47b1-9b99-26d5c930cc15",
    "name": "Que Sale - 00 Setup",
    "description": "Preparación inicial para la demo. Esta primera etapa registra una universidad; las solicitudes de cuentas, estudiantes e intereses se agregarán cuando sus contratos estén implementados y disponibles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "universityName",
      "value": "Universidad de prueba Postman"
    },
    {
      "key": "universityEmailDomain",
      "value": "pruebas.quesale.local"
    },
    {
      "key": "universityId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Registrar universidad",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{universityName}}\",\n  \"emailDomain\": \"{{universityEmailDomain}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/universities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "universities"
          ]
        },
        "description": "Prerequisito de perfiles. Usa un nombre y dominio que todavía no estén registrados; cambia las variables de la colección antes de repetir la solicitud. Esperado: 201 Created."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Universidad creada', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    const university = pm.response.json();",
              "    pm.expect(university.id).to.be.a('number');",
              "    pm.expect(university.name).to.eql(pm.collectionVariables.get('universityName'));",
              "    pm.expect(university.emailDomain).to.eql(pm.collectionVariables.get('universityEmailDomain'));",
              "    pm.collectionVariables.set('universityId', university.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Listar universidades",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/universities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "universities"
          ]
        },
        "description": "Comprueba que la universidad creada aparece en el catálogo. Esperado: 200 OK."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Universidades listadas', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "if (pm.response.code === 200) {",
              "    const universities = pm.response.json();",
              "    const universityId = Number(pm.collectionVariables.get('universityId'));",
              "    pm.test('La universidad creada está en el catálogo', function () {",
              "        pm.expect(universities.some(function (university) { return university.id === universityId; })).to.eql(true);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Rechazar universidad duplicada → 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{universityName}}\",\n  \"emailDomain\": \"{{universityEmailDomain}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/universities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "universities"
          ]
        },
        "description": "Ejecuta después de registrar correctamente la universidad. Reutiliza el mismo dominio para comprobar que el dominio de correo no puede duplicarse. Esperado: 409 Conflict."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El dominio universitario duplicado se rechaza', function () {",
              "    pm.response.to.have.status(409);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Obtener universidad creada",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/universities/{{universityId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "universities",
            "{{universityId}}"
          ]
        },
        "description": "Usa universityId, guardado por la solicitud de registro. Esperado: 200 OK con los datos de la universidad."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Universidad encontrada', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    const university = pm.response.json();",
              "    pm.test('Los datos coinciden con la universidad registrada', function () {",
              "        pm.expect(university.id).to.eql(Number(pm.collectionVariables.get('universityId')));",
              "        pm.expect(university.name).to.eql(pm.collectionVariables.get('universityName'));",
              "        pm.expect(university.emailDomain).to.eql(pm.collectionVariables.get('universityEmailDomain'));",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Universidad inexistente → 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/universities/-1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "universities",
            "-1"
          ]
        },
        "description": "Consulta un ID negativo que no puede corresponder a una universidad creada con identidad autogenerada. Esperado: 404 Not Found."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Universidad inexistente responde 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
