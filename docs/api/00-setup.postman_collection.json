  "item": [
    {
      "name": "Create UTP university",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Universidad Tecnologica del Peru\",\n  \"emailDomain\": \"utp.edu.pe\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/universities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "universities"
          ]
        },
        "description": "Expected: 201 Created. Saves utpUniversityId for the UTP students."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UTP university is created', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.emailDomain).to.eql('utp.edu.pe');",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.collectionVariables.set('utpUniversityId', body.id);",
              "});"
            ]
          }
        }
      ]
    },
