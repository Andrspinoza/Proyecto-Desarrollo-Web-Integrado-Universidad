apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: quesale
  namespace: quesale
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ domain }}
      secretName: quesale-tls
  rules:
    - host: {{ domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: api
                port:
                  number: 8080
