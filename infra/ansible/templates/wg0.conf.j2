[Interface]
Address = {{ wg_ip }}/24
ListenPort = {{ wg_port }}
PrivateKey = {{ wg_private_key }}

{% for h in groups['k3s_servers'] if h != inventory_hostname %}
[Peer]
PublicKey = {{ hostvars[h].wg_public_key }}
Endpoint = {{ hostvars[h].ansible_host }}:{{ wg_port }}
AllowedIPs = {{ hostvars[h].wg_ip }}/32
PersistentKeepalive = 25

{% endfor %}
